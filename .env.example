# ================================================
# VOICE.AI SERVER CONFIGURATION
# ================================================
# Copy this file to .env and fill in your API keys
# All settings have sensible defaults in src/config/constants.js

# ================================================
# REQUIRED API KEYS
# ================================================
SARVAM_API_KEY=
SARVAM_API_SUBSCRIPTION_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# ================================================
# GOOGLE CALENDAR (for demo booking)
# ================================================
# Service Account Email from Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Service Account Private Key (keep \n for newlines)
# Example: "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# IMPORTANT: Use service account email as calendar ID, NOT "primary"
# "primary" refers to the service account's own empty calendar
GOOGLE_CALENDAR_ID=

# ================================================
# SERVER CONFIGURATION
# ================================================
PORT=8081
VOICE_SERVER_WS_PATH=/
VOICE_SERVER_HEARTBEAT_MS=30000
VOICE_SERVER_LOG_LEVEL=info
VOICE_SERVER_URL=ws://127.0.0.1:8081/

# ================================================
# DEFAULT PROVIDER
# ================================================
DEFAULT_PROVIDER=groq

# ================================================
# STT (Speech-to-Text) CONFIGURATION
# ================================================
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_LANGUAGE_CODE=gu-IN
SARVAM_STT_SAMPLE_RATE=16000
SARVAM_STT_INPUT_AUDIO_CODEC=wav
SARVAM_STT_ENCODING=audio/wav
SARVAM_STT_HIGH_VAD_SENSITIVITY=true
SARVAM_STT_VAD_SIGNALS=true
SARVAM_STT_FLUSH_SIGNAL=true

# ================================================
# TTS (Text-to-Speech) CONFIGURATION
# ================================================
SARVAM_TTS_WS_URL=wss://api.sarvam.ai/text-to-speech/ws?model=bulbul:v3&send_completion_event=true
TTS_SPEAKER=shubh
TTS_TARGET_LANGUAGE_CODE=gu-IN
TTS_PACE=1.0
TTS_MIN_BUFFER_SIZE=30
TTS_MAX_CHUNK_LENGTH=50
TTS_OUTPUT_CODEC=wav
TTS_MAX_TEXT_CHARS=180
TTS_FLUSH_DELAY_MS=2
TTS_SAMPLE_RATE=24000

# ================================================
# GROQ LLM CONFIGURATION
# ================================================
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=2000
GROQ_TOP_P=1
GROQ_REASONING_EFFORT=low
GROQ_STOP=null
GROQ_ALLOW_REASONING_FALLBACK=false
GROQ_SYSTEM_PROMPT=

# ================================================
# CEREBRAS LLM CONFIGURATION
# ================================================
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_TEMPERATURE=0.2
CEREBRAS_MAX_TOKENS=2000
CEREBRAS_TOP_P=1
CEREBRAS_REASONING_EFFORT=low
CEREBRAS_STOP=null
CEREBRAS_ALLOW_REASONING_FALLBACK=false
CEREBRAS_SYSTEM_PROMPT=

# ================================================
# SARVAM LLM CONFIGURATION
# ================================================
# Set DEFAULT_PROVIDER=sarvam to use Sarvam LLM
# Available models: sarvam-m, gemma-4b
SARVAM_LLM_MODEL=sarvam-m
SARVAM_LLM_TEMPERATURE=0.2
SARVAM_LLM_MAX_TOKENS=2000
SARVAM_LLM_TOP_P=1
SARVAM_LLM_STOP=null
SARVAM_LLM_SYSTEM_PROMPT=

# ================================================
# GEMINI LLM CONFIGURATION
# ================================================
# Set DEFAULT_PROVIDER=gemini to use Gemini LLM
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_TOKENS=2000
GEMINI_TOP_P=1
GEMINI_STOP=null
GEMINI_SYSTEM_PROMPT=

# ================================================
# PIPELINE CONFIGURATION
# ================================================
BRIDGE_FLUSH_TIMEOUT_MS=120
VOICE_PIPELINE_TRANSCRIPT_GRACE_MS=220
VOICE_PIPELINE_TRANSCRIPT_MAX_WAIT_MS=1400
VOICE_PIPELINE_TRANSCRIPT_POLL_MS=120
VOICE_PIPELINE_LATE_TRANSCRIPT_MAX_MS=3000
VOICE_PIPELINE_MIN_TRANSCRIPT_CHARS=2
VOICE_PIPELINE_MIN_PROMPT_CHARS=8
VOICE_PIPELINE_MIN_PROMPT_WORDS=2
VOICE_PIPELINE_ABORT_ON_START_SPEECH=true
VOICE_PIPELINE_ABORT_ON_TRANSCRIPT=false
VOICE_PIPELINE_ABORT_ON_TRANSCRIPT_MIN_CHARS=2
VOICE_PIPELINE_SEND_ON_TRANSCRIPT=true
VOICE_PIPELINE_SEND_ON_TRANSCRIPT_MIN_CHARS=12
VOICE_PIPELINE_SEND_ON_TRANSCRIPT_DEBOUNCE_MS=300
VOICE_PIPELINE_SKIP_END_AFTER_LIVE_DISPATCH=true
VOICE_PIPELINE_DEDUP_REPEATED_TRANSCRIPT=true
VOICE_PIPELINE_CONTEXT_ENABLED=true
VOICE_PIPELINE_CONTEXT_MAX_TURNS=500
VOICE_PIPELINE_CONTEXT_MAX_CHARS=4000
VOICE_PIPELINE_STREAM_DEBUG=true
VOICE_PIPELINE_STREAM_DEBUG_MAX_PREVIEWS=2
VOICE_PIPELINE_STREAM_DEBUG_PREVIEW_CHARS=220
VOICE_PIPELINE_TTS_SANITIZE=true
VOICE_PIPELINE_ECHO_GUARD_ENABLED=true
VOICE_PIPELINE_ECHO_GUARD_MIN_CHARS=4
VOICE_PIPELINE_ECHO_GUARD_TOKEN_OVERLAP=0.8
VOICE_PIPELINE_VERBOSE_MODEL=true

# ================================================
# SYSTEM PROMPT
# ================================================
VOICE_SYSTEM_PROMPT_FILE=prompts/system_prompt.md
VOICE_SYSTEM_PROMPT=

# ================================================
# CLIENT CONFIGURATION (for voice-client-live.js)
# ================================================
MIC_DEVICE=pulse
SPEAKER_DEVICE=pulse
VOICE_CLIENT_VERBOSE=false
VOICE_SPEAKER_RESTART_DELAY_MS=50
VOICE_CLIENT_RECONNECT_DELAY=1000
VOICE_CLIENT_RECONNECT_MAX_DELAY=10000
