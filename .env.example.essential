# ================================================
# ESSENTIAL ENVIRONMENT VARIABLES FOR DEPLOYMENT
# ================================================
# Copy this file to .env and fill in your API keys
# This contains ONLY the essential variables needed
# for Railway/Render deployment of voice.ai server

# ================================================
# SERVER CONFIGURATION
# ================================================
PORT=8081
VOICE_SERVER_WS_PATH=/
VOICE_SERVER_HEARTBEAT_MS=30000
VOICE_SERVER_LOG_LEVEL=info

# ================================================
# REQUIRED API KEYS (MUST FILL IN)
# ================================================
# Sarvam AI - Required for STT and TTS
SARVAM_API_KEY=

# LLM Provider - Choose one or both
GROQ_API_KEY=
CEREBRAS_API_KEY=

# ================================================
# DEFAULTS
# ================================================
DEFAULT_PROVIDER=groq

# ================================================
# LANGUAGE & TTS DEFAULTS
# ================================================
SARVAM_STT_LANGUAGE_CODE=hi-IN
TTS_TARGET_LANGUAGE_CODE=hi-IN
TTS_SPEAKER=shubh

# ================================================
# PIPELINE ESSENTIAL SETTINGS
# ================================================
VOICE_PIPELINE_CONTEXT_ENABLED=true
VOICE_PIPELINE_CONTEXT_MAX_TURNS=8
VOICE_PIPELINE_STREAM_DEBUG=false