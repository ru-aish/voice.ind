# ================================================
# ESSENTIAL ENVIRONMENT VARIABLES FOR DEPLOYMENT
# ================================================
# Copy this file to .env and fill in your API keys
# This contains ONLY the essential variables needed
# for Railway/Render deployment of voice.ai server

# ================================================
# REQUIRED API KEYS (MUST FILL IN)
# ================================================
SARVAM_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=

# ================================================
# SERVER CONFIGURATION
# ================================================
PORT=8081
VOICE_SERVER_WS_PATH=/
VOICE_SERVER_HEARTBEAT_MS=30000
VOICE_SERVER_LOG_LEVEL=info

# ================================================
# DEFAULTS
# ================================================
DEFAULT_PROVIDER=groq

# Optional: choose sarvam or gemini as default provider too
# DEFAULT_PROVIDER=sarvam
# DEFAULT_PROVIDER=gemini

# ================================================
# STT (Speech-to-Text)
# ================================================
SARVAM_STT_LANGUAGE_CODE=hi-IN

# ================================================
# TTS (Text-to-Speech)
# ================================================
TTS_TARGET_LANGUAGE_CODE=hi-IN
TTS_SPEAKER=shubh
TTS_PACE=1.0

# ================================================
# PIPELINE SETTINGS
# ================================================
VOICE_PIPELINE_CONTEXT_ENABLED=true
VOICE_PIPELINE_CONTEXT_MAX_TURNS=1200
VOICE_PIPELINE_CONTEXT_MAX_CHARS=120000
VOICE_PIPELINE_STREAM_DEBUG=false
VOICE_PIPELINE_TRACE_FULL=false
